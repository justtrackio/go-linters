package inlineprivate

func localPrivateStruct() (struct{ privateField int }, error) {
	return struct{ privateField int }{privateField: 1}, nil
}

func use(int) {}

func SamePackagePrivateStruct() error {
	var value struct{ privateField int }
	var err error
	// want "if err can be inlined by declaring value, err before the assignment and changing := to ="
	if value, err = localPrivateStruct(); err != nil {
		return err
	}

	use(value.privateField)
	return nil
}
