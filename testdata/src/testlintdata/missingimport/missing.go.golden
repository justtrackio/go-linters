package missingimport

import (
	"testlintdata/iferrinline/widget"
	time2 "time"
)

func Capacity() (int, error) {
	time := 1
	var value time2.Duration
	var err error
	// want "if err can be inlined by declaring value, err before the assignment and changing := to ="
	if value, err = widget.Duration(); err != nil {
		return 0, err
	}

	var count int
	// want "if err can be inlined by declaring count before the assignment and changing := to ="
	if count, err = convert(int(value)); err != nil {
		return 0, err
	}

	return count + time, nil
}

func convert(value int) (int, error) { return value, nil }

func Other() (int, error) {
	var value time2.Duration
	var err error
	// want "if err can be inlined by declaring value, err before the assignment and changing := to ="
	if value, err = widget.Duration(); err != nil {
		return 0, err
	}

	return int(value), nil
}
