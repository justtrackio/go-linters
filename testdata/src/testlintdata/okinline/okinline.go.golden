package okinline

import "testlintdata/iferrinline/widget"

func normalize() (string, bool) { return "event", true }
func use(string)                {}
func check() bool               { return true }

func EventUsedAfter() string {
	var event string
	var ok bool
	// want "if ok can be inlined by declaring event, ok before the assignment and changing := to ="
	if event, ok = normalize(); !ok {
		return "not configured"
	}

	return event
}

func EventOnlyInIf() {
	if event, ok := normalize(); !ok {
		use(event)
	}
}

func PositiveCheck() {
	if event, ok := normalize(); ok {
		use(event)
	} else {
		use(event)
	}
}

func BlankCompanion() {
	if _, ok := normalize(); !ok {
		return
	}
}

func BooleanOnly() {
	if ok := check(); !ok {
		return
	}
}

func AssignmentUsedAfter() bool {
	var event string
	var ok bool
	if event, ok = normalize(); !ok {
		return ok
	}
	use(event)
	return ok
}

func BothUsedAfter() (string, bool) {
	var event string
	var ok bool
	// want "if ok can be inlined by declaring event, ok before the assignment and changing := to ="
	if event, ok = normalize(); !ok {
		return "", ok
	}

	return event, ok
}

func ExistingVar() string {
	var ok bool
	var event string
	// want "if ok can be inlined by declaring event before the assignment and changing := to ="
	if event, ok = normalize(); !ok {
		return ""
	}

	return event
}

func Parameter(event string) string {
	var ok bool
	// want "if ok can be inlined by declaring ok before the assignment and changing := to ="
	if event, ok = normalize(); !ok {
		return ""
	}

	return event
}

func Consecutive() {
	var first string
	var ok bool
	// want "if ok can be inlined by declaring first, ok before the assignment and changing := to ="
	if first, ok = normalize(); !ok {
		return
	}

	var second string
	// want "if ok can be inlined by declaring second before the assignment and changing := to ="
	if second, ok = normalize(); !ok {
		return
	}

	use(first)
	use(second)
}

func MapLookup(events map[string]string) string {
	var event string
	var ok bool
	// want "if ok can be inlined by declaring event, ok before the assignment and changing := to ="
	if event, ok = events["event"]; !ok {
		return ""
	}

	return event
}

func TypeAssertion(value any) {
	if event, ok := value.(string); !ok {
		use(event)
	}
}

func ChannelReceive(events <-chan string) string {
	var event string
	var ok bool
	// want "if ok can be inlined by declaring event, ok before the assignment and changing := to ="
	if event, ok = <-events; !ok {
		return ""
	}

	return event
}

func Parenthesized() {
	if ok := check(); !(ok) {
		return
	}
}

func Nested() {
	for i := 0; i < 2; i++ {
		var event string
		var ok bool
		// want "if ok can be inlined by declaring event, ok before the assignment and changing := to ="
		if event, ok = normalize(); !ok {
			return
		}

		use(event)
	}
}

func IfInitOkShadow() string {
	if _, ok := normalize(); ok {
		var event string
		var ok bool
		// want "if ok can be inlined by declaring event, ok before the assignment and changing := to ="
		if event, ok = normalize(); !ok {
			return ""
		}

		return event
	}
	return ""
}

func widgetOK() (*widget.Service, bool) { return nil, true }

func PackageShadow() *widget.Service {
	_ = widget.Service{}
	var widget *widget.Service
	var ok bool
	// want "if ok can be inlined by declaring widget, ok before the assignment and changing := to ="
	if widget, ok = widgetOK(); !ok {
		return nil
	}

	return widget
}

func AlreadyInline() {
	if event, ok := normalize(); !ok {
		use(event)
	}
}

func OkOnlyUsedAfter() bool {
	ok := check()
	if !ok {
		return false
	}
	return ok
}

func DifferentName() {
	event, found := normalize()
	if !found {
		use(event)
	}
}

func DifferentCondition() {
	event, ok := normalize()
	if event == "" {
		use(event)
	}
	_ = ok
}

func CompoundCondition() {
	event, ok := normalize()
	if !ok || event == "" {
		return
	}
}

func InterveningStatement() {
	event, ok := normalize()
	use(event)
	if !ok {
		return
	}
}

func ExistingIfInit() {
	event, ok := normalize()
	if other := check(); !ok {
		use(event)
		_ = other
	}
}

func MultiLine() {
	event, ok := func() (string, bool) {
		return normalize()
	}()
	if !ok {
		use(event)
	}
}
